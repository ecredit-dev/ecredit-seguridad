            "data": {
              "type": "tm.Actor",
              "name": "Analista / Administrador",
              "description": "Personal interno que revisa, aprueba o rechaza solicitudes.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "providesAuthentication": true,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "t-02",
                  "title": "Repudio en aprobación manual de créditos (R)",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Un analista aprueba un crédito fraudulento o altera su estado y niega la acción por falta de logs inmutables con usuario, IP y marca de tiempo.",
                  "mitigation": "Registrar eventos de auditoría append-only en SQL Server con ID de analista, timestamp UTC e IP origen.",
                  "modelType": "STRIDE",
                  "number": 2,
                  "score": "4"
                }
              ]
            }
          },
