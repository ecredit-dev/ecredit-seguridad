            "zIndex": 4,
            "data": {
              "type": "tm.Process",
              "name": "Backend API (Node.js)",
              "description": "API REST para autenticación JWT, validaciones y control de acceso.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "privilegeLevel": "Servicio Backend",
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "t-04",
                  "title": "IDOR en consulta de solicitudes de crédito (I)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information Disclosure",
                  "description": "Un cliente autenticado altera el parámetro ID en GET /api/solicitudes/{id} y accede a cédula, ingresos y referencias de otros clientes.",
                  "mitigation": "Validar propiedad del recurso comparando el user_id del JWT contra el titular en SQL Server; devolver 404 si no coincide.",
                  "modelType": "STRIDE",
                  "number": 4,
                  "score": "9"
                },
                {
                  "id": "t-05",
                  "title": "Elevación de privilegios por Mass Assignment (E)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of Privilege",
                  "description": "Un usuario envía el atributo 'rol: ADMIN' en el JSON de registro o actualización de perfil y obtiene permisos de aprobador.",
                  "mitigation": "Filtrar campos permitidos mediante DTO estrictos (allowlist) ignorando atributos de rol o estado.",
                  "modelType": "STRIDE",
                  "number": 5,
                  "score": "8"
                },
                {
                  "id": "t-06",
                  "title": "Agotamiento de servicio por falta de Rate Limiting (D)",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of Service",
                  "description": "Peticiones automatizadas masivas a /api/login y /api/evaluar saturan el event loop de Node.js y el pool de SQL Server.",
                  "mitigation": "Aplicar rate limiting de máximo 10 req/min por IP/usuario y paginación obligatoria en consultas.",
                  "modelType": "STRIDE",
                  "number": 6,
                  "score": "6"
                }
              ]
            }
          },
