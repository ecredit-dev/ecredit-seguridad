            "data": {
              "type": "tm.Process",
              "name": "Motor de Crédito (Java)",
              "description": "Lógica de negocio, cálculo de cupo, tasas y aprobación.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "privilegeLevel": "Core Financiero",
              "handlesCardPayment": false,
              "handlesGoodsOrServices": true,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "t-07",
                  "title": "Lógica de Negocio: Duplicación de cupo por Race Condition (T)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Un solicitante envía múltiples peticiones simultáneas de aprobación en milisegundos antes de actualizar su saldo comprometido, obteniendo doble desembolso.",
                  "mitigation": "Ejecutar validación de cupo y descuento bajo transacción SQL con bloqueo pesimista (UPDLOCK/SERIALIZABLE).",
                  "modelType": "STRIDE",
                  "number": 7,
                  "score": "9"
                },
                {
                  "id": "t-08",
                  "title": "Manipulación de monto y tasa calculada desde cliente (T)",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "El atacante intercepta el payload HTTP y modifica el monto aprobado o tasa de interés confiando en cálculos enviados desde el frontend.",
                  "mitigation": "Recalcular montos máximos, plazos y tasas exclusivamente en el servicio Java ignorando valores enviados por el cliente.",
                  "modelType": "STRIDE",
                  "number": 8,
                  "score": "6"
                }
              ]
            }
