              "type": "tm.Process",
              "name": "Frontend / Portal Web",
              "description": "Interfaz web de captura de solicitudes y consulta de estado.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "privilegeLevel": "Público",
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "t-03",
                  "title": "Robo de sesión JWT vía XSS almacenado (I)",
                  "status": "Open",
                  "severity": "Low",
                  "type": "Information Disclosure",
                  "description": "Inyección de script en campos de referencias personales que extrae el token JWT guardado en localStorage.",
                  "mitigation": "Almacenar tokens en cookies HttpOnly + Secure + SameSite=Strict y sanitizar salidas en el DOM.",
                  "modelType": "STRIDE",
                  "number": 3,
                  "score": "3"
                }
              ]
            }
          },
          {
            "position": { "x": 600, "y": 250 },
