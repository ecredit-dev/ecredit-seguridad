              "outOfScope": false,
              "reasonOutOfScope": "",
              "providesAuthentication": false,
              "hasOpenThreats": true,
              "threats": [
                {
                  "id": "t-01",
                  "title": "Suplantación de identidad en registro y solicitud (S)",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Spoofing",
                  "description": "Un tercero usa datos de cédula filtrados para crear una cuenta y solicitar un crédito a nombre de otra persona sin verificación de identidad robusta.",
                  "mitigation": "Implementar validación OTP por correo/SMS y verificación de titularidad antes de habilitar el cupo.",
                  "modelType": "STRIDE",
                  "number": 1,
                  "score": "4"
                }
              ]
            }
          },
          {
            "position": { "x": 60, "y": 380 },
